# Shared secret configured on the GitHub webhook; webhooks are rejected while it is empty.
GITHUB_WEBHOOK_SECRET=
# Optional: leave blank for public repositories unless GitHub rate limits require a token.
GITHUB_TOKEN=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Choose a password; docker-compose.yml reads it via --env-file backend/.env.
NEO4J_PASSWORD=
# Set these on the backend to use chat and ingestion, respectively.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional override; defaults to backend/.cache/embeddings.sqlite3.
# Set EMBEDDING_CACHE_PATH= to disable persistent embedding reuse.
# EMBEDDING_CACHE_PATH=/absolute/writable/path/embeddings.sqlite3
# Optional JSON list of dashboard origins allowed by CORS; defaults to the local
# Vite (5173) and alternate (3000) dev-server origins.
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
