# Replace before accepting GitHub webhooks. This value is only for local development.
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Optional: leave blank for public repositories unless GitHub rate limits require a token.
GITHUB_TOKEN=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Matches the local-only docker-compose.yml credentials.
NEO4J_PASSWORD=gladline
# Set these on the backend to use chat and ingestion, respectively.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
