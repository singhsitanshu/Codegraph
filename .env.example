GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Optional, but recommended for private repositories and higher API rate limits:
# GITHUB_TOKEN=github-token-with-read-access-to-the-repository

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password
NEO4J_DATABASE=neo4j

ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5
